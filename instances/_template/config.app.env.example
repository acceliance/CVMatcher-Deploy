# Application de l'instance — copié en config.app.env par scripts/new-instance.ps1 (secrets générés), jamais versionné.
# Devient /opt/cvmatcher/.env sur la VM (0600).
CVMATCHER_IMAGE_NAMESPACE=acceliance
TAG=__TAG__
INSTANCE_FQDN=__FQDN__
PUBLIC_URL=https://__FQDN__
COMPOSE_PROFILES=__PROFILES__

NEO4J_PASSWORD=__SECRET_NEO4J__
SESSION_SECRET=__SECRET_SESSION__
DATA_ENCRYPTION_KEY=__SECRET_FERNET__

AUTH_MODE=__AUTH_MODE__
OAUTH2_PROVIDER=__OAUTH2_PROVIDER__
OAUTH2_OIDC_ISSUER_URL=__OAUTH2_ISSUER__
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=__SECRET_OAUTH2_COOKIE__
OAUTH2_REDIRECT_URL=https://__FQDN__/oauth2/callback
OAUTH2_ALLOWED_DOMAINS=__ALLOWED_DOMAINS__
OIDC_GROUP_ROLES=

AI_EGRESS_ALLOWED=true
FILE_STORE=__FILE_STORE__
FILE_QUOTA_GB=200
S3_ENDPOINT=__S3_ENDPOINT__
S3_BUCKET=__S3_BUCKET__
S3_REGION=us-east-1
S3_ACCESS_KEY=__S3_ACCESS_KEY__
S3_SECRET_KEY=__S3_SECRET_KEY__
VECTOR_BACKEND=neo4j
QDRANT_API_KEY=
THEME_ASSET_HOSTS=
THEME_EXTRACTION_ALLOWED=true

MCP_ENABLED=
MCP_WRITES=false
MCP_ALLOWED_HOSTS=__FQDN__:*
MCP_ALLOWED_ORIGINS=https://__FQDN__
A2A_ENABLED=
A2A_PUBLIC_URL=https://__FQDN__/api
A2A_TASK_TIMEOUT=240

METRICS_ALLOWED_IPS=127.0.0.1
# Mémoire Neo4j (§8) : 1536m/1536m pour une VM de 8 Go ; 4G/4G pour 16 Go ; 8G/12G pour 32 Go.
NEO4J_HEAP=1536m
NEO4J_PAGECACHE=1536m
OCR_CPUS=4
