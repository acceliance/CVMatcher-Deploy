# Hôte de l'instance (kit/ubuntu) — copié en config.env par scripts/new-instance.ps1, jamais versionné.
DOMAIN=__FQDN__
SSH_HOST=__FQDN__
SSH_USER=ubuntu
ADMIN_IP=__ADMIN_IP__
CUSTOMER_IPS=__CUSTOMER_IPS__
LETSENCRYPT_EMAIL=exploitation@acceliance.fr
INSTALL_COCKPIT=false
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
# copie externe chiffrée (obligatoire en production) : s3://bucket/prefixe ou utilisateur@hôte:/chemin
BACKUP_REMOTE=
BACKUP_S3_ENDPOINT=
BACKUP_AGE_RECIPIENT=
