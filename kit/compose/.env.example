# CVMatcher — variables de l'instance (spec de déploiement §3.1). Copier en .env, jamais dans git.
# Les secrets sont générés par scripts/new-instance.ps1 ; ne jamais réutiliser une valeur entre instances.

# --- Images (jamais « latest » en production) ---
CVMATCHER_IMAGE_PREFIX=harbor.acceliance.fr/cvmatcher
TAG=v0-0000000

# --- Instance ---
INSTANCE_FQDN=cvmatcher-client.example.fr
PUBLIC_URL=https://cvmatcher-client.example.fr
ENVIRONMENT=production

# --- Secrets (générés) ---
NEO4J_PASSWORD=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_PREVIOUS=     # pendant une rotation seulement (§4.6)

# --- Authentification : standalone | office365 | google ---
AUTH_MODE=standalone
# OIDC (profil federated)
OAUTH2_PROVIDER=oidc
OAUTH2_OIDC_ISSUER_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
OAUTH2_REDIRECT_URL=https://cvmatcher-client.example.fr/oauth2/callback
OAUTH2_ALLOWED_DOMAINS=
# correspondance optionnelle groupe de l'IdP → rôle : groupe=rôle;groupe=rôle
OIDC_GROUP_ROLES=

# --- IA ---
AI_EGRESS_ALLOWED=true
AI_MAX_RETRIES=2

# --- Fichiers : local | s3 ---
FILE_STORE=local
FILE_QUOTA_GB=200
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Index vectoriel : neo4j | qdrant (profil vectors-qdrant) ---
VECTOR_BACKEND=neo4j
QDRANT_API_KEY=

# --- Thème : hôtes externes autorisés (vide = aucun) ---
THEME_ASSET_HOSTS=
THEME_EXTRACTION_ALLOWED=true

# --- Agents MCP / A2A (vide = choix dans l'interface, false = veto) ---
MCP_ENABLED=
MCP_WRITES=false
MCP_ALLOWED_HOSTS=cvmatcher-client.example.fr:*
MCP_ALLOWED_ORIGINS=https://cvmatcher-client.example.fr
A2A_ENABLED=
A2A_PUBLIC_URL=https://cvmatcher-client.example.fr/api
A2A_TASK_TIMEOUT=240

# --- Exploitation ---
METRICS_ALLOWED_IPS=127.0.0.1
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G
OCR_CPUS=4
SESSION_TTL_HOURS=8
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=200
LOG_LEVEL=INFO
